ENV_SCHEMA_VERSION=7
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_BOT_API_BIN=telegram-bot-api
TELEGRAM_BOT_API_HOST=127.0.0.1
TELEGRAM_BOT_API_PORT=8081
TELEGRAM_BOT_API_DIR=./data/telegram-bot-api
ALLOWED_CHAT_ID=replace-with-telegram-group-chat-id

OBS_HOST=127.0.0.1
# 1..65535
OBS_PORT=4455
OBS_PASSWORD=
# Trimmed values must not be blank and must be different.
OBS_LOOP_SOURCE_NAME=tg_loop_player
OBS_MUSIC_SOURCE_NAME=tg_music_player

DATA_DIR=./data
MEDIA_DIR=./data/media
LOOP_MEDIA_DIR=./data/media/loops
MUSIC_MEDIA_DIR=./data/media/music
DATABASE_PATH=./data/state.db

# Numeric config must be valid integers; malformed values fail startup.
# MAX_VIDEO_SIZE_MB must be >0.
# MAX_VIDEO_DURATION_SECONDS and MIN_FREE_DISK_MB allow 0.
# MIN_FREE_DISK_MB=0 disables only the reserve; actual-size admission remains.
MAX_VIDEO_SIZE_MB=2000
MAX_VIDEO_DURATION_SECONDS=7200
MIN_FREE_DISK_MB=512
FFPROBE_PATH=ffprobe
LOG_LEVEL=info
